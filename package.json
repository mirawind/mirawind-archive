{
  "name": "mirawind-archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "generate:content-types": "node scripts/generate-content-types.mjs",
    "benchmark:environment": "tsx scripts/benchmarks/environment.ts",
    "benchmark:library": "tsx scripts/benchmarks/library.ts",
    "benchmark:build": "tsx scripts/benchmarks/build.ts",
    "benchmark:read": "tsx scripts/benchmarks/read.ts",
    "benchmark:read-during-build": "tsx scripts/benchmarks/read-during-build.ts",
    "benchmark:reference": "tsx scripts/benchmarks/reference.ts",
    "benchmark:search": "tsx scripts/benchmarks/search.ts",
    "architecture:check": "tsx scripts/architecture/dependency-graph.ts src",
    "architecture:imports": "tsx scripts/architecture/canonical-imports.ts",
    "architecture:names": "tsx scripts/architecture/semantic-names.ts",
    "build": "astro build && vite build --config vite.processes.config.ts && node scripts/copy-runtime-schemas.mjs",
    "commitlint": "commitlint",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/entrypoints/cli/index.ts db migrate",
    "dev": "NODE_ENV=development MIRAWIND_LOCAL_DEVELOPMENT_TRUST=1 node --env-file-if-exists=.env --import tsx scripts/dev.mjs",
    "dev:web": "NODE_ENV=development astro dev",
    "dev:worker": "NODE_ENV=development tsx src/entrypoints/worker/index.ts",
    "format": "prettier --check package.json pnpm-workspace.yaml tsconfig.json tsconfig.processes.json astro.config.mjs eslint.config.js commitlint.config.mjs vitest.config.ts playwright.config.ts CONTRIBUTING.md .github/workflows src tests scripts docs/operations docs/third-party",
    "format:write": "prettier --write package.json pnpm-workspace.yaml tsconfig.json tsconfig.processes.json astro.config.mjs eslint.config.js commitlint.config.mjs vitest.config.ts playwright.config.ts CONTRIBUTING.md .github/workflows src tests scripts docs/operations docs/third-party",
    "fixtures:build-stress": "tsx scripts/fixtures/build-stress-book.ts",
    "fixtures:author-references": "tsx scripts/fixtures/author-mineru-references.ts",
    "fixtures:compare-references": "tsx scripts/fixtures/compare-mineru-references.ts",
    "fixtures:observe-references": "tsx scripts/fixtures/observe-mineru-references.ts",
    "fixtures:reference-pack": "tsx scripts/fixtures/create-mineru-reference-pack.ts",
    "fixtures:verify-real": "tsx scripts/fixtures/verify-real-mineru.ts",
    "lint": "pnpm architecture:imports && pnpm architecture:check && pnpm architecture:names && eslint . && node scripts/check-style-tokens.mjs",
    "mirawind": "node --env-file-if-exists=.env --import tsx src/entrypoints/cli/index.ts",
    "prebuild": "pnpm prepare:assets",
    "predev": "pnpm prepare:assets",
    "prepare:assets": "pnpm prepare:renderer-assets && pnpm prepare:reader-assets && pnpm prepare:styles",
    "prepare:reader-assets": "node scripts/prepare-reader-assets.mjs",
    "prepare:renderer-assets": "node scripts/prepare-renderer-assets.mjs",
    "prepare:styles": "tailwindcss -i src/styles/reader.css -o public/_astro/styles/mirawind-reader-v5-tailwind-4.3.3.css --minify",
    "preview": "astro preview",
    "start": "node dist/server/entry.mjs",
    "test": "vitest run --passWithNoTests",
    "pretest": "pnpm prepare:assets",
    "pretest:integration": "pnpm prepare:assets",
    "test:architecture": "vitest run --project architecture --passWithNoTests",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "typecheck": "node scripts/generate-content-types.mjs --check && astro check && tsc --noEmit && tsc -p tsconfig.processes.json --noEmit",
    "worker": "node dist/processes/worker/index.js"
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@better-auth/passkey": "1.6.25",
    "@fastify/busboy": "3.2.0",
    "@inquirer/prompts": "8.5.2",
    "@shikijs/transformers": "4.3.1",
    "@streamparser/json": "^0.0.22",
    "@tanstack/react-virtual": "^3.14.8",
    "@zip.js/zip.js": "2.8.34",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.1.3",
    "better-auth": "1.6.25",
    "better-sqlite3": "12.11.1",
    "diff": "9.0.0",
    "entities": "6.0.1",
    "katex": "0.18.1",
    "lucide-react": "^1.26.0",
    "mermaid": "11.16.0",
    "parse5": "7.3.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "sharp": "0.35.3",
    "shiki": "4.3.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@astrojs/check": "0.9.9",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/katex": "0.16.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "json-schema-to-typescript": "15.0.4",
    "lightningcss": "1.33.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
